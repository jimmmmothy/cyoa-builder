<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:Editor.Views"
             xmlns:viewmodels="using:Editor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Editor.Views.ConditionalBranchNodePropertiesView"
             x:DataType="viewmodels:ConditionalBranchNodeViewModel">
  <Grid Margin="20" RowDefinitions="Auto, *">
    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
      <Label Grid.Column="0" Content="{Binding Title}"></Label>
      <Label Grid.Column="1"></Label>
      <Button Grid.Column="2" Command="{Binding AddRouteCommand}">+</Button>
    </Grid>    
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Routes}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel></StackPanel>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="viewmodels:RouteViewModel">
          <views:RoutePropertiesView></views:RoutePropertiesView>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
