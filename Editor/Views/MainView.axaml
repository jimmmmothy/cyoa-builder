<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:editor="using:Editor"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="using:Editor.ViewModels"
        xmlns:views="using:Editor.Views"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900  "
        x:Class="Editor.Views.MainView"
        x:DataType="viewmodels:MainViewModel"
        Title="Storio Editor">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="3*"></RowDefinition>
            <RowDefinition Height="2"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Border Classes="title" Grid.Row="0" Padding="7.5">
            <TextBlock Classes="title" HorizontalAlignment="Stretch">
                STORIO
            </TextBlock>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,2, *">
            
            <!-- Side bar -->
            <TabControl Grid.Column="0"> 
                <TabItem Header="Components">
                    <StackPanel>
                        <Button HorizontalAlignment="Stretch" Command="{Binding SpawnPageNodeCommand}">Page</Button>
                        <Button HorizontalAlignment="Stretch" Command="{Binding SpawnBranchNodeCommand}">Branch</Button>
                        <Button HorizontalAlignment="Stretch" Command="{Binding SpawnConditionalBranchNodeCommand}">Conditional Branch</Button>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Story Definition">
                    <TreeView>
                        <TreeViewItem>first</TreeViewItem>
                        <TreeViewItem>second</TreeViewItem>
                    </TreeView>
                </TabItem>
            </TabControl>
            <GridSplitter Grid.Column="1"></GridSplitter>

            <!-- Canvas of nodes -->
            <Panel Name="Workspace" Grid.Column="2" Classes="workspace">
                <ItemsControl ZIndex="1" ItemsSource="{Binding Nodes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Classes="bg-none"></Canvas>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter" x:DataType="viewmodels:NodeViewModelBase">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <editor:ViewLocator></editor:ViewLocator>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Canvas of connections -->
                <ItemsControl ItemsSource="{Binding Connections}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Classes="bg-none"></Canvas>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <editor:ViewLocator></editor:ViewLocator>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Panel>
            
        </Grid>

        <GridSplitter Grid.Row="2"></GridSplitter>
        
        <!-- Properties -->
        <Border Grid.Row="3" Background="{DynamicResource PrimaryBackground}" Opacity="1">
            <ContentControl Content="{Binding SelectedNode}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="viewmodels:PageNodeViewModel">
                        <views:PageNodePropertiesView></views:PageNodePropertiesView>
                    </DataTemplate>
                    <DataTemplate DataType="viewmodels:BranchNodeViewModel">
                        <views:BranchNodePropertiesView></views:BranchNodePropertiesView>
                    </DataTemplate>
                    <DataTemplate DataType="viewmodels:ConditionalBranchNodeViewModel">
                        <views:ConditionalBranchNodePropertiesView></views:ConditionalBranchNodePropertiesView>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Border>
    </Grid>
</Window>
