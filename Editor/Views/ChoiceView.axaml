<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Editor.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:Editor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Editor.Views.ChoiceView"
             ClipToBounds="False"
             x:DataType="viewmodels:ChoiceViewModel">
  <Panel>
    <Label Content="{Binding Label}" Padding="10,0"></Label>
    <local:PortView x:Name="Port" Anchor="{Binding Outgoing, Mode=OneWayToSource}" Direction="Outgoing" Classes="outgoing"></local:PortView>
  </Panel>
</UserControl>
