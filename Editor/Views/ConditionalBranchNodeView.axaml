<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="using:Editor.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:Editor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Editor.Views.ConditionalBranchNodeView"
             x:DataType="viewmodels:ConditionalBranchNodeViewModel"
             ClipToBounds="False">

  <Panel Classes="node" Classes.selected="{Binding IsSelected}">
    <views:PortView Direction="Incoming" Anchor="{Binding Incoming, Mode=OneWayToSource}" Classes="incoming"></views:PortView>
    <Border Classes="node-body" Width="{Binding Width}" MinHeight="{Binding Height}" Padding="0,10">
      <Grid RowDefinitions="1*, 1*, Auto, 1*">
        <TextBlock Grid.Row="0" Text="{Binding Title}" Margin="10"></TextBlock>
        <TextBlock Grid.Row="1"></TextBlock>
        <ItemsControl Grid.Row="2" Padding="0" ClipToBounds="False" ItemsSource="{Binding Routes}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="5"></StackPanel>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <views:RouteView></views:RouteView>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Panel Grid.Row="3" Margin="0, 5, 0, 0">
          <Label Content="Default" Padding="10,0"></Label>
          <views:PortView x:Name="Port" Anchor="{Binding Outgoing, Mode=OneWayToSource}" Direction="Outgoing" Classes="outgoing"></views:PortView>
        </Panel>
      </Grid>
    </Border>
  </Panel>
</UserControl>
