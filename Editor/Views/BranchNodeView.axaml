<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:Editor.Views"
             xmlns:viewmodels="using:Editor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Editor.Views.BranchNodeView"
             x:DataType="viewmodels:BranchNodeViewModel"
             ClipToBounds="False">

  <Panel Classes="node" Classes.selected="{Binding IsSelected}">
    <views:PortView Direction="Incoming" Anchor="{Binding Incoming, Mode=OneWayToSource}" Classes="incoming"></views:PortView>
    <Border Classes="node-body" Width="{Binding Width}" MinHeight="{Binding Height}" Padding="0,10">
      <Grid RowDefinitions="1*, 1*, Auto">
        <TextBlock Grid.Row="0" Text="{Binding Title}" Margin="10"></TextBlock>
        <TextBlock Grid.Row="1"></TextBlock>
        <ItemsControl Grid.Row="2" Padding="0" ClipToBounds="False" ItemsSource="{Binding Choices}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="5"></StackPanel>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <views:ChoiceView></views:ChoiceView>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>
  </Panel>
</UserControl>
